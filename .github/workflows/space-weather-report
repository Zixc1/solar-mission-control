name: Publish Online Space Weather Website

on:
  workflow_dispatch:

  schedule:
    - cron: "0 */6 * * *"

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: github-pages
  cancel-in-progress: true

jobs:
  generate-report:
    name: Generate website
    runs-on: ubuntu-24.04

    steps:
      - name: Create website directory
        run: mkdir -p website

      - name: Pull Docker image
        run: docker pull zixc1/solar-mission-control:latest

      - name: Generate report
        env:
          NASA_API_KEY: ${{ secrets.NASA_API_KEY }}
        run: |
          docker run --rm \
            --user "$(id -u):$(id -g)" \
            --env NASA_API_KEY \
            --env HOME=/tmp \
            --env MPLCONFIGDIR=/tmp/matplotlib \
            -v "$PWD/website:/app/swrl_report" \
            zixc1/solar-mission-control:latest

      - name: Prepare website
        run: |
          test -f website/space_weather_report.html
          cp website/space_weather_report.html website/index.html
          touch website/.nojekyll

          echo "Website files:"
          find website -maxdepth 3 -type f | sort

      - name: Configure GitHub Pages
        uses: actions/configure-pages@v5

      - name: Upload GitHub Pages artifact
        uses: actions/upload-pages-artifact@v4
        with:
          path: website

  deploy:
    name: Publish website
    needs: generate-report
    runs-on: ubuntu-24.04

    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}

    steps:
      - name: Deploy website
        id: deployment
        uses: actions/deploy-pages@v4
